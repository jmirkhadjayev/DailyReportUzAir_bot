# Bu — NAMUNA fayl. Uni `.env` deb nusxalang va o'z ma'lumotlaringizni yozing.
# `.env` fayli hech qachon GitHubga tushmaydi (.gitignore da).

# --- Majburiy sozlamalar ---

# @BotFather dan olingan token
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Boshqarma boshlig'ining Telegram ID raqami.
# Bir nechta bo'lsa vergul bilan: 111111111,222222222
# ID ni bilish uchun: botga /id buyrug'ini yuboring yoki @userinfobot ga yozing.
ADMIN_IDS=111111111

# --- Qo'shimcha sozlamalar ---

# Hujjatlar sarlavhasida chiqadigan tashkilot nomi
ORG_NAME=Raqamlashtirish va kiberxavfsizlikni ta'minlash boshqarmasi

# Hujjatlardagi imzo joyida turadigan boshliq F.I.Sh.
CHIEF_NAME=Atabayev F.F
CHIEF_NAME_RU=Атабаев Ф.Ф

# Hujjatlar pastida chiqadigan imzo
FOOTER_TEXT=created by mirkhadjayev.uz

TIMEZONE=Asia/Tashkent

# Hodimlarga "hisobotni topshiring" eslatmasi yuboriladigan vaqt
REMINDER_TIME=17:00

# Boshliqqa kunlik xulosa yuboriladigan vaqt
DIGEST_TIME=18:00

# Eslatmalar faqat ish kunlari (Du-Ju) yuborilsinmi
WORKDAYS_ONLY=true
